# Development-only example. Do not use these values in production.
IPMS_SECRET_KEY=replace-with-a-random-development-secret
IPMS_CONNECTOR_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key
IPMS_AGENT_PKI_MASTER_KEY=replace-with-a-separate-base64-encoded-32-byte-key
IPMS_AGENT_DEPLOYMENT_MASTER_KEY=replace-with-another-base64-encoded-32-byte-key
IPMS_AGENT_WINDOWS_PACKAGE_PATH=/srv/ipms/shared/agent-artifacts/ipms-agent-windows-x64.zip
IPMS_AGENT_WINDOWS_PACKAGE_SHA256=replace-with-the-pinned-package-sha256
IPMS_AGENT_WINDOWS_VERSION=0.2.25
IPMS_AGENT_DEPLOYMENT_CONNECT_TIMEOUT_SECONDS=30
IPMS_AGENT_DEPLOYMENT_READ_TIMEOUT_SECONDS=180
IPMS_AGENT_DEPLOYMENT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
IPMS_BMC_CONNECT_TIMEOUT_SECONDS=45
IPMS_CERTIFICATE_PROBE_TOKEN=replace-with-a-random-64-character-hex-token
IPMS_CERTIFICATE_PROBE_PORT=8010
IPMS_ALLOWED_HOSTS=localhost,127.0.0.1
IPMS_CSRF_TRUSTED_ORIGINS=http://localhost:8000
IPMS_DATABASE_NAME=ipms
IPMS_DATABASE_USER=ipms
IPMS_DATABASE_PASSWORD=replace-with-a-database-password
IPMS_DATABASE_HOST=127.0.0.1
IPMS_DATABASE_PORT=5432
IPMS_HSTS_SECONDS=0
