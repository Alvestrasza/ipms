+}
+
+/* IPMS: external verification runs before CA/known-host fallbacks. */
+static int ipms_rdp_verify_x509(freerdp* instance, const BYTE* data,
+        size_t length, const char* hostname, UINT16 port, DWORD flags) {
+    rdpContext* context = GUAC_RDP_CONTEXT(instance);
+    guac_client* client = ((rdp_freerdp_context*) context)->client;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+    (void) port;
+    if (!hostname || strcmp(hostname, "127.0.0.1")) return 0;
+    return ipms_verify_native_certificate(
+        rdp_client->settings->certificate_fingerprints, data, length, flags);
+}
