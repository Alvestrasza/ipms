[Unit]
Description=IPMS BMC Certificate Probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ipms-connector-worker
Group=ipms-connector-worker
WorkingDirectory=/srv/ipms/current/services/control-plane
EnvironmentFile=/srv/ipms/shared/certificate-probe.env
Environment=PYTHONPATH=/srv/ipms/current/services/control-plane/src
ExecStart=/srv/ipms/current/services/control-plane/.venv/bin/python -m ipms.apps.discovery.certificate_probe_service
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=10.0.0.0/8
IPAddressAllow=172.16.0.0/12
IPAddressAllow=192.168.0.0/16
IPAddressAllow=fc00::/7
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
